<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.ghosthack</groupId>
    <artifactId>ffmpeg-ffm-parent</artifactId>
    <version>8.1.2-0.3.4</version>
  </parent>

  <artifactId>ffmpeg-ffm-natives</artifactId>
  <packaging>pom</packaging>

  <name>ffmpeg-ffm natives</name>
  <description>From-source LGPL FFmpeg shared libraries, one classifier jar per platform</description>

  <!-- Unlike the parent (MIT binding code), these jars convey FFmpeg binaries. -->
  <licenses>
    <license>
      <name>GNU Lesser General Public License v2.1 or later</name>
      <url>https://www.gnu.org/licenses/old-licenses/lgpl-2.1.html</url>
      <distribution>repo</distribution>
      <comments>FFmpeg built from unmodified source; statically linked dav1d is BSD-2-Clause. See BUILD-INFO.txt and COPYING files inside each jar.</comments>
    </license>
  </licenses>

  <!--
    src/main/resources/natives/<classifier>/ is populated by build-natives/<classifier>.sh
    on the matching machine. The jar for the current platform is built with that
    classifier; other platforms' directories are simply absent locally.
  -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <executions>
          <execution>
            <id>natives-jar</id>
            <phase>package</phase>
            <goals><goal>jar</goal></goals>
            <configuration>
              <classesDirectory>src/main/resources</classesDirectory>
              <classifier>${native.classifier}</classifier>
              <includes>
                <include>natives/${native.classifier}/**</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- CI deploy: both platforms' staged natives are present (downloaded as build
       artifacts), so attach both classifier jars in one reactor run and Central
       receives a single deployment bundle. -->
  <profiles>
    <profile>
      <id>all-natives</id>
      <properties>
        <native.classifier>macos-arm64</native.classifier>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <version>3.4.2</version>
            <executions>
              <execution>
                <id>natives-jar-windows</id>
                <phase>package</phase>
                <goals><goal>jar</goal></goals>
                <configuration>
                  <classesDirectory>src/main/resources</classesDirectory>
                  <classifier>windows-x64</classifier>
                  <includes>
                    <include>natives/windows-x64/**</include>
                  </includes>
                </configuration>
              </execution>
              <execution>
                <id>natives-jar-linux</id>
                <phase>package</phase>
                <goals><goal>jar</goal></goals>
                <configuration>
                  <classesDirectory>src/main/resources</classesDirectory>
                  <classifier>linux-x64</classifier>
                  <includes>
                    <include>natives/linux-x64/**</include>
                  </includes>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
